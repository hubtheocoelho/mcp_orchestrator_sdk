# Normalize line endings: LF in the repo, auto-converted on checkout.
* text=auto eol=lf

# Explicitly text
*.ts   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary (never diff or convert)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
